{
  "expo": {
    "name": "EstudarJuntos",
    "slug": "EstudarJuntos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estudarjuntos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#FFFFFF",
      "navigationBar": {
        "visible": true,
        "barStyle": "dark-content",
        "backgroundColor": "#00000000"
      }
    },
    "web": {
      "output": "static",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
